<section class="product-main py-12" style="margin-top: 4rem;">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">

      {%- comment -%} Gallery {%- endcomment -%}
      <div class="product-gallery">
        <div class="main-image rounded-2xl overflow-hidden bg-gray-50 aspect-square mb-3">
          {%- if product.featured_image != blank -%}
            <img
              id="ProductFeaturedImage"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | escape | default: product.title }}"
              width="900"
              height="900"
              class="w-full h-full object-contain"
              loading="eager"
            >
          {%- else -%}
            <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-slate-100 to-slate-200">
              <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-slate-300" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </div>
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="thumbnails flex gap-2 overflow-x-auto pb-1">
            {%- for image in product.images -%}
              <button
                class="thumbnail-btn flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 border-transparent hover:border-[#9700cd] transition-colors focus:outline-none focus:border-[#9700cd]"
                data-src="{{ image | image_url: width: 900 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 120 }}" alt="{{ image.alt | escape }}" width="64" height="64" class="w-full h-full object-cover" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product info {%- endcomment -%}
      <div class="product-info">
        <p class="text-sm text-gray-400 uppercase tracking-wider mb-1">{{ product.vendor }}</p>
        <h1 class="text-3xl font-extrabold text-gray-900 mb-3">{{ product.title }}</h1>

        <div class="product-price flex items-baseline gap-3 mb-6">
          {%- if product.compare_at_price > product.price -%}
            <span class="text-gray-400 line-through text-xl">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="text-3xl font-bold text-gray-900" id="ProductPrice">
            {%- if product.price_varies -%}From {% endif -%}
            {{ product.price | money }}
          </span>
          {%- if product.compare_at_price > product.price -%}
            <span class="text-[#ff00f5] text-sm font-bold bg-[#ff00f5]/10 px-2 py-0.5 rounded-full">Save {{ product.compare_at_price | minus: product.price | money }}</span>
          {%- endif -%}
        </div>

        {%- form 'product', product, id: 'ProductForm', data-type: 'add-to-cart-form' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="variant-option mb-4">
                <label class="block text-sm font-semibold text-gray-700 mb-2">{{ option.name }}</label>
                <div class="flex flex-wrap gap-2">
                  {%- for value in option.values -%}
                    <input
                      type="radio"
                      id="Option{{ option.position }}_{{ forloop.index }}"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      class="sr-only peer"
                      {%- if option.selected_value == value -%} checked{%- endif -%}
                    >
                    <label
                      for="Option{{ option.position }}_{{ forloop.index }}"
                      class="px-4 py-2 border-2 border-gray-200 rounded-full text-sm font-medium cursor-pointer peer-checked:border-[#9700cd] peer-checked:text-[#9700cd] hover:border-[#9700cd] transition-colors"
                    >
                      {{ value }}
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="ProductVariantId">
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {%- endunless -%}

          <div class="flex items-center gap-3 mb-6">
            <div class="qty-selector flex items-center border-2 border-gray-200 rounded-full overflow-hidden">
              <button type="button" class="qty-minus w-10 h-10 flex items-center justify-center text-gray-600 hover:text-[#9700cd] hover:bg-gray-50 transition-colors" aria-label="Decrease quantity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
              </button>
              <input type="number" name="quantity" value="1" min="1" class="qty-input w-12 text-center text-sm font-semibold border-none outline-none bg-transparent" aria-label="Quantity">
              <button type="button" class="qty-plus w-10 h-10 flex items-center justify-center text-gray-600 hover:text-[#9700cd] hover:bg-gray-50 transition-colors" aria-label="Increase quantity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
              </button>
            </div>
          </div>

          <button
            type="submit"
            class="add-to-cart-btn w-full py-4 rounded-full font-bold text-white text-base transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-[1.02]"
            style="background: linear-gradient(to right, #9700cd, #e315c1);"
            {%- unless product.available -%} disabled{%- endunless -%}
          >
            {%- if product.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product-description mt-8 prose prose-sm max-w-none text-gray-600 leading-relaxed">
            {{ product.description }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Main",
  "settings": [],
  "presets": [
    {
      "name": "Product Main"
    }
  ]
}
{% endschema %}
